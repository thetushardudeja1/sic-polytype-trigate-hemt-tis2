;; n-channel C-face 3C/4H HEMT (APL 2024), planar 2D, t3C=0.024 um
(sde:clear)
(sdegeo:set-default-boolean "ABA")
(sdegeo:create-rectangle (position 0 0 0) (position 16.0 0.024 0) "SiliconCarbide" "C3s")
(sdegeo:create-rectangle (position 16.0 0 0) (position 26.0 0.024 0) "SiliconCarbide" "C3g")
(sdegeo:create-rectangle (position 26.0 0 0) (position 42.0 0.024 0) "SiliconCarbide" "C3d")
(sdegeo:create-rectangle (position 0 0.024 0) (position 42.0 2.024 0) "4HSiC" "Sub4H")
(sdegeo:insert-vertex (position 1.0 0 0))
(sdegeo:insert-vertex (position 41.0 0 0))
(sdedr:define-constant-profile "P3C" "PhosphorusActiveConcentration" 1e15)
(sdedr:define-constant-profile-region "D3s" "P3C" "C3s")
(sdedr:define-constant-profile-region "D3g" "P3C" "C3g")
(sdedr:define-constant-profile-region "D3d" "P3C" "C3d")
(sdedr:define-constant-profile "PSub" "PhosphorusActiveConcentration" 1e10)
(sdedr:define-constant-profile-region "DSub" "PSub" "Sub4H")
(sdedr:define-refeval-window "WconS" "Rectangle" (position 0 0 0) (position 1.0 0.034 0))
(sdedr:define-refeval-window "WconD" "Rectangle" (position 41.0 0 0) (position 42.0 0.034 0))
(sdedr:define-constant-profile "Pcon" "NitrogenActiveConcentration" 1e19)
(sdedr:define-constant-profile-placement "DconS" "Pcon" "WconS")
(sdedr:define-constant-profile-placement "DconD" "Pcon" "WconD")
(sdegeo:define-contact-set "source" 4 (color:rgb 1 0 0) "##")
(sdegeo:set-current-contact-set "source")
(sdegeo:define-2d-contact (find-edge-id (position 0.5 0 0)) "source")
(sdegeo:define-contact-set "drain" 4 (color:rgb 1 0 0) "##")
(sdegeo:set-current-contact-set "drain")
(sdegeo:define-2d-contact (find-edge-id (position 41.5 0 0)) "drain")
(sdegeo:define-contact-set "gate" 4 (color:rgb 1 0 0) "##")
(sdegeo:set-current-contact-set "gate")
(sdegeo:define-2d-contact (find-edge-id (position 21.0 0 0)) "gate")
(sdedr:define-refeval-window "Wall" "Rectangle" (position 0 0 0) (position 42.0 2.024 0))
(sdedr:define-refinement-size "SWall" 0.5 0.25 0.02 0.002)
(sdedr:define-refinement-placement "PWall" "SWall" "Wall")
(sdedr:define-refeval-window "W3C" "Rectangle" (position 0 0 0) (position 42.0 0.024 0))
(sdedr:define-refinement-size "SW3C" 0.5 0.003 0.02 0.0005)
(sdedr:define-refinement-placement "PW3C" "SW3C" "W3C")
(sdedr:define-refeval-window "Wif" "Rectangle" (position 0 0.019 0) (position 42.0 0.044 0))
(sdedr:define-refinement-size "SWif" 0.5 0.0008 0.02 0.0002)
(sdedr:define-refinement-placement "PWif" "SWif" "Wif")
(sdedr:define-refeval-window "Wsub" "Rectangle" (position 0 0.044 0) (position 42.0 0.324 0))
(sdedr:define-refinement-size "SWsub" 0.5 0.02 0.02 0.002)
(sdedr:define-refinement-placement "PWsub" "SWsub" "Wsub")
(sdedr:define-refeval-window "Wx0" "Rectangle" (position 0.8 0 0) (position 1.2 0.054 0))
(sdedr:define-refinement-size "SWx0" 0.02 0.002 0.004 0.0005)
(sdedr:define-refinement-placement "PWx0" "SWx0" "Wx0")
(sdedr:define-refeval-window "Wx1" "Rectangle" (position 15.8 0 0) (position 16.2 0.054 0))
(sdedr:define-refinement-size "SWx1" 0.02 0.002 0.004 0.0005)
(sdedr:define-refinement-placement "PWx1" "SWx1" "Wx1")
(sdedr:define-refeval-window "Wx2" "Rectangle" (position 25.8 0 0) (position 26.2 0.054 0))
(sdedr:define-refinement-size "SWx2" 0.02 0.002 0.004 0.0005)
(sdedr:define-refinement-placement "PWx2" "SWx2" "Wx2")
(sdedr:define-refeval-window "Wx3" "Rectangle" (position 40.8 0 0) (position 41.2 0.054 0))
(sdedr:define-refinement-size "SWx3" 0.02 0.002 0.004 0.0005)
(sdedr:define-refinement-placement "PWx3" "SWx3" "Wx3")
(sde:build-mesh "hemt")
